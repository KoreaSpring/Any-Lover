node_modules/

# 后端组装与冻结（可复现，不入库）
build/pyinstaller/
dist-runtime/

# 内置 Ollama、ffmpeg、OpenSeeFace（体积大，由脚本拉取或本地拷贝，不入库）
vendor/

# 后端 ASR/TTS 模型缓存（prepare-runtime 会复用或重新下载）
backend/models/

# Python 字节码（任意目录）
__pycache__/

# 运行期日志
*.log

# 打包用的 Python 虚拟环境（见 README「完整重建」）
.venv-pack/

# 临时脚本：任意目录下以 _ 开头的 .ps1；build/scripts 下以 _ 开头的 .js / .mjs
_*.ps1
build/scripts/_*.js
build/scripts/_*.mjs

# THA / EasyVtuber 渲染运行时（源在 integrations/easyvtuber/runtime/，产物在根 dist-tha-runtime/）
# 打包组装产物（含嵌入式 Python，可由 integrations/easyvtuber/prepare.js 再生）
dist-tha-runtime/
# 开发/验证用的本地 venv 与首启依赖标记
integrations/easyvtuber/runtime/.venv/
integrations/easyvtuber/runtime/.deps-installed
integrations/easyvtuber/runtime/_pip_tha.log
# 立绘预处理产物（用户上传抠图后生成，运行期数据）
integrations/easyvtuber/runtime/data/images/*_512.png
# THA 模型（体积大；由 fetch-tha-models 下载或本地准备）
integrations/easyvtuber/runtime/data/models/
integrations/easyvtuber/runtime/data/rembg/
